DOLBOMEUM_API_PROXY_TARGET=http://127.0.0.1:8000

# true면 백엔드 없이 src/api/mock.ts의 예시 응답으로 화면을 확인한다(접수~초안까지만).
# 18~34번에서 모든 화면을 실제 API에 연결했으므로 기본값은 false. 통합·배포에서도 false.
VITE_USE_MOCK_API=false

# 공식 누리집 화면(전자정부 누리집 표시, 보건복지부 로고·하단, ‘가상’ 표현 정리). 팀장 확정 디자인으로 기본값 true.
# false로 두면 ‘가상 사례 시연’ 표시로 돌아간다. frontend/src/siteConfig.ts 참고.
VITE_OFFICIAL_SITE=true
