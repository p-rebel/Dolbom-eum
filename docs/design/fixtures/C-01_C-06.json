{
  "basePath": "/api/v1",
  "instructions": "각 사례를 별도 초기화된 시연 DB에서 commonSteps, 선택한 scenarios, finalCheck 순으로 실행한다. actor의 세션과 앱 Origin을 사용한다. capture는 응답 JSON Pointer의 값을 저장한다. 경로 안 변수는 문자열로, JSON 값 전체인 변수는 캡처한 JSON 타입 그대로 치환한다. expect.body는 객체의 지정 키를 재귀 비교한다. 배열은 길이와 순서까지 비교한다. expect.errorCode는 error.code를 비교한다.",
  "accounts": {
    "town": { "username": "demo-town-a", "role": "TOWN", "districtCode": "DEMO-A", "townCode": "DEMO-A-1" },
    "district": { "username": "demo-district-a", "role": "DISTRICT", "districtCode": "DEMO-A", "townCode": null },
    "outside": { "username": "demo-town-b", "role": "TOWN", "districtCode": "DEMO-B", "townCode": "DEMO-B-1" },
    "otherTown": { "username": "demo-town-a2", "role": "TOWN", "districtCode": "DEMO-A", "townCode": "DEMO-A-2" }
  },
  "profile": {
    "code": "DEMO-ELDER-01",
    "beneficiaryName": "가상 대상자 01",
    "applicantName": "가상 대리 신청인 01",
    "noticeRecipientName": "가상 대리 신청인 01",
    "region": { "districtCode": "DEMO-A", "townCode": "DEMO-A-1", "sido": "충청북도", "sigungu": "음성군" }
  },
