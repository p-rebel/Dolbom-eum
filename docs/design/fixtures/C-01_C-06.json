      "expect": {
        "http": 201,
        "body": {
          "status": "RECEIVED", "version": 1, "beneficiaryName": "가상 대상자 01",
          "receivedOn": "2026-11-01", "noticeMethod": "SMS", "evidenceChecked": true,
          "profile": { "code": "DEMO-ELDER-01", "applicantName": "가상 대리 신청인 01", "noticeRecipientName": "가상 대리 신청인 01" },
          "screening": null, "assessment": null, "plan": null, "monitoring": null,
          "events": [{ "action": "RECEIVE", "fromStatus": null, "toStatus": "RECEIVED", "actorRole": "TOWN", "version": 1, "itemId": null }],
          "allowedActions": [{ "action": "RECORD_SCREENING", "itemId": null }]
        }
      },
      "capture": { "caseId": "/id", "receiptNumber": "/receiptNumber" }
    },
    {
      "actor": "town", "method": "POST", "path": "/cases",
      "headers": { "Idempotency-Key": "demo-receive-01" },
      "body": { "profileCode": "DEMO-ELDER-01", "receivedOn": "2026-11-01", "noticeMethod": "SMS", "evidenceChecked": true },
      "expect": {
        "http": 200,
        "body": {
          "id": "{{caseId}}", "receiptNumber": "{{receiptNumber}}", "status": "RECEIVED", "version": 1,
          "events": [{ "action": "RECEIVE", "version": 1 }]
        }
      }
    },
    {
      "actor": "town", "method": "POST", "path": "/cases",
      "headers": { "Idempotency-Key": "demo-receive-01" },
      "body": { "profileCode": "DEMO-ELDER-01", "receivedOn": "2026-11-02", "noticeMethod": "SMS", "evidenceChecked": true },
      "expect": { "http": 409, "errorCode": "IDEMPOTENCY_CONFLICT", "body": { "error": { "field": null } } }
